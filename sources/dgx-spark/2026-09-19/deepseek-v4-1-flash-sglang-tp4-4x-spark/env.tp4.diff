--- .env.tp4.example	2026-09-18 23:43:46.688004930 +0200
+++ .env.tp4	2026-09-19 07:17:20.831512077 +0200
@@ -2,18 +2,18 @@
 # Used by ./start-tp4.sh; ./start.sh keeps using .env (3 Sparks).
 
 # ─── cluster ──────────────────────────────────────────────────────────────────
-HEAD_IP=10.0.0.1
-WORKER_IPS="10.0.0.2 10.0.0.3 10.0.0.4"
-WORKER_HOSTS="spark2 spark3 spark4"
-WORKER_USER=zurih
-SSH_IDENTITY=$HOME/.ssh/id_ed25519_shared
+HEAD_IP=10.10.10.12
+WORKER_IPS="10.10.10.11 10.10.10.14 10.10.10.13"
+WORKER_HOSTS="<tailnet-ip-of-spark-2822> 10.10.10.14 10.10.10.13"
+WORKER_USER=sero
+SSH_IDENTITY=$HOME/.ssh/id_ed25519
 
 # ─── fabric (ConnectX-7 RoCE triangle) ────────────────────────────────────────
 # Gloo/NCCL TCP bootstrap on the LAN NIC. Data plane prefers RoCE (NCCL_NET=IB).
 FABRIC_IFACE=enp1s0f1np1
-GLOO_SOCKET_IFNAME=enP7s7
-NCCL_SOCKET_IFNAME=enP7s7
-IB_HCA=rocep1s0f0,rocep1s0f1
+GLOO_SOCKET_IFNAME=enp1s0f1np1,enP2p1s0f1np1
+NCCL_SOCKET_IFNAME=enp1s0f1np1,enP2p1s0f1np1
+IB_HCA=rocep1s0f1,roceP2p1s0f1
 NCCL_NET=IB
 NCCL_IB_DISABLE=0
 NCCL_P2P_DISABLE=1
@@ -32,7 +32,7 @@
 NCCL_HOST_DIR=$HOME/nccl-2.30.7
 
 # ─── model / image ────────────────────────────────────────────────────────────
-MODEL_DIR=$HOME/NewModels/DeepSeek-V4.1-Flash
+MODEL_DIR=/home/sero/work/deepseek-v41-exl3/source
 COMMON_MODEL=/var/tmp/DeepSeek-V4.1-Flash
 BASE_IMAGE=lmsysorg/sglang:dev-dsv41
 IMAGE=dsv41-4x-spark:local
@@ -43,11 +43,11 @@
 # normally goes through a switch: give one server address for all workers, or one
 # per worker in WORKER_IPS order (NFS_SERVER_IPS="a b c").
 # spark2 mounts 10.0.22.1; spark3 mounts 10.0.23.1 (pairwise CX7).
-NFS_SHARE=1
+NFS_SHARE=0
 NFS_VOLUME=dsv41-weights
 NFS_EXPORT_NAME=dsv41-native
-NFS_SERVER_IPS="10.0.22.1"
-NFS_CLIENTS=10.0.0.2,10.0.0.3,10.0.0.4,10.0.22.0/24
+NFS_SERVER_IPS="10.10.10.12"
+NFS_CLIENTS=10.10.10.0/24
 
 # ─── parallelism (4 Sparks) ──────────────────────────────────────────────────
 # TP=4 EP=4 matches world size. heads=64 / o_groups=8 / draft experts=128 /
@@ -229,3 +229,7 @@
 # 3-Spark profile. At TP4 every shard holds real weights, so no head padding.
 DSV41_TP_PAD=0
 WORKER_DIR=/home/$WORKER_USER/dsv41-4x-spark
+
+# local additions (mixed accounts across this fleet; user-independent worker dir on local NVMe)
+WORKER_USERS="sero valentine valentine"
+WORKER_DIR=/var/tmp/dsv41-4x-spark

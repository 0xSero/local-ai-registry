+def dsv41_ragged_verify_buffers(forward_batch, bs: int):
+    """DSV41 local patch (engram / low-ratio consumers of compact ragged verify).
+
+    Returns (verify_lens, extend_start_loc) for the ``bs`` rows of this target-verify
+    batch, taken from the DSV4 attention backend's static buffers. The backend fills
+    them from the layout padded to the captured slot count in both eager runs and
+    CUDA-graph replay (init_forward_metadata_target_verify), so sum(verify_lens)
+    equals the batch's token count and graph replays see live values. None when the
+    batch verifies equal blocks, or for the DSpark draft (its blocks are always full).
+    """
+    if resolve_ragged_verify_layout(forward_batch) is None:
+        return None
+    if read_ragged_verify_mode() is not RaggedVerifyMode.COMPACT:
+        return None
+    from sglang.srt.model_executor.forward_context import get_attn_backend
+
+    backend = get_attn_backend()
+    if getattr(backend, "is_dspark_draft", False):
+        return None
+    lens = getattr(backend, "extend_seq_lens_buffer", None)
+    starts = getattr(backend, "extend_start_loc_buffer", None)
+    if lens is None or starts is None:
+        return None
+    return lens[:bs], starts[:bs]

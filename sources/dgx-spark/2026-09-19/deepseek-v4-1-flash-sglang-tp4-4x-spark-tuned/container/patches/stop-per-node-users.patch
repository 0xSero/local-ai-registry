--- a/stop.sh
+++ b/stop.sh
@@ -68,6 +68,20 @@
   done
 fi
 WORKER_USER="${WORKER_USER:-zurih}"
+# local patch: fleets whose nodes use different accounts. WORKER_USERS is aligned with
+# WORKER_HOSTS. start.sh has carried this since the per-node-user delta; stop.sh did not, so
+# `stop` silently left the container running on every node whose account differs from
+# WORKER_USER, which then broke the next `serve` with a container-name conflict.
+read -r -a WORKER_USER_LIST <<< "${WORKER_USERS:-}"
+user_for() {
+  local i
+  for i in "${!WORKER_HOSTS[@]}"; do
+    if [[ "${WORKER_HOSTS[$i]}" == "$1" && -n "${WORKER_USER_LIST[$i]:-}" ]]; then
+      echo "${WORKER_USER_LIST[$i]}"; return
+    fi
+  done
+  echo "$WORKER_USER"
+}
 SSH_IDENTITY="$(_abs "${SSH_IDENTITY:-$HOME/.ssh/id_ed25519_shared}")"
 NFS_VOLUME="${NFS_VOLUME:-dsv41-weights}"
 IMAGE="${IMAGE:-dsv41-3x-spark:local}"
@@ -85,7 +99,7 @@
   local env_args=()
   [[ -f "$ENV_FILE" ]] && env_args=(--env-file "$ENV_FILE")
   python3 "$REMOTE_PY" "${env_args[@]}" \
-    --host "$host" --user "$WORKER_USER" \
+    --host "$host" --user "$(user_for "$host")" \
     --identity "$SSH_IDENTITY" \
     --timeout "${REMOTE_TIMEOUT:-60}" \
     "bash -lc $(printf '%q' "$*")"
@@ -126,7 +140,7 @@
 fi
 

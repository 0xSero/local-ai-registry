# Site configuration for the DeepSeek-V4.1-Flash 4x DGX Spark recipe runner.
#
# Copy, fill in the SITE block, mount at /etc/dsv41/site.env. Contains no secrets:
# the ssh key is mounted separately and HF_TOKEN is passed on the command line or via --env.
#
# Everything under TUNED was measured on a four-Spark fleet. Changing any of it invalidates the
# published numbers; re-measure with the dsbench gate before trusting a changed value.

# ─────────────────────────── SITE — you must set these ───────────────────────
# Fabric address of the head node (rank 0). Workers dial this for NCCL bootstrap.
HEAD_IP=10.10.10.12
# Fabric addresses of ranks 1..3, in rank order.
WORKER_IPS="10.10.10.11 10.10.10.14 10.10.10.13"
# Addresses the head can actually ssh to. Often differs from the fabric IPs, because the RoCE
# interface may not run sshd. In rank order, aligned with WORKER_IPS.
WORKER_HOSTS="10.10.10.11 10.10.10.14 10.10.10.13"
# Account on each worker, in the same order. A single value applies to all.
# Fleets whose nodes use different accounts need one entry per worker.
WORKER_USER=sero
WORKER_USERS="sero sero sero"

# Where the 476 GiB checkpoint lives ON THE HOST. This container must see it at the SAME path,
# because the path is passed through to the serving containers.
MODEL_DIR=/var/lib/dsv41/DeepSeek-V4.1-Flash
COMMON_MODEL=/var/tmp/DeepSeek-V4.1-Flash
# Per-node Engram shard directory (NVMe recommended).
ENGRAM_DIR=/var/lib/dsv41/engram

# RoCE / NCCL. These are fleet-specific: check `ip link` and `ibv_devices` on your nodes.
FABRIC_IFACE=enp1s0f1np1
GLOO_SOCKET_IFNAME=enp1s0f1np1,enP2p1s0f1np1
NCCL_SOCKET_IFNAME=enp1s0f1np1,enP2p1s0f1np1
IB_HCA=rocep1s0f1,roceP2p1s0f1

# Checkpoint distribution. NFS_SHARE=1 exports the head checkpoint to the workers over the fabric;
# NFS_SHARE=0 expects each worker to already hold a local copy.
NFS_SHARE=0
NFS_VOLUME=dsv41-weights

# ─────────────────────── WEIGHTS — pinned, do not drift ──────────────────────
HF_REPO=deepseek-ai/DeepSeek-V4.1-Flash
HF_REVISION=fb2764a5cf321eaa5070ca8f9e892818f477c16d
EXPECTED_SHARDS=48
# HF_TOKEN is NOT set here. Pass it at run time if the repo is gated for you.

# ───────────────────────────── ENGINE image ──────────────────────────────────
BASE_IMAGE=lmsysorg/sglang:dev-dsv41
IMAGE=dsv41-4x-spark:canary-roce
SERVED_MODEL_NAME=deepseek-v4.1-flash
PORT=8888

# ──────────────────── TUNED — re-measure before changing ─────────────────────
NNODES=4
TP_SIZE=4
# EP_SIZE=1 cannot boot: the MXFP4 kernel needs intermediate_size_per_partition % 128 == 0
# and 2304/4 = 576. EP_SIZE=2 is the working value.
EP_SIZE=2
DIST_PORT=20000

CONTEXT_LENGTH=1048576
# 6M, not 8M. At 8M with 48 slots the fleet idles at 5-8 GB MemAvailable per node and a single
# cold 420k prefill drove one node to 1.05 GB. At 6M the same node bottoms out at 4.7 GB.
MAX_TOTAL_TOKENS=6000000
MAX_RUNNING_REQUESTS=48
CHUNKED_PREFILL_SIZE=4096
MEM_FRACTION_STATIC=0.80
HEAD_MEM_FRACTION_STATIC=0.80

SPEC_ALGO=DSPARK
# Block 6 and 7 were both measured worse. 5 is the kept value.
DSPARK_BLOCK_SIZE=5
DSPARK_SPS_TABLE=/state/dspark_sps.json
DSPARK_STS_TABLE=/state/dspark_sts.json

OFFLOAD_MODE=nvme
DSV41_CACHE_GIB=4
DSV41_IO_THREADS=96
DSV41_MXFP8_BACKEND=b12x
DSV41_SHARED_PAD_K=1
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0

# No server-side output cap. The upstream adapter defaults this to 32768, which silently clamps
# every request including clients that send no limit.
DSV41_MAX_NEW_TOKENS=0
# Repetition-only abort. Set 0 to disable entirely.
DSV41_LOOP_ABORT=1

# --prefill-decode-interval 4 is a fairness control, not a speed win: while a cold 150k prompt
# prefills, chat streams fall to 1.6 tok/s without it and hold 21.7 tok/s with it, at the cost of
# 38% higher TTFT on the deep request.
EXTRA_SGLANG_ARGS="--fp8-gemm-backend flashinfer_cutlass --watchdog-timeout 1800 --min-free-slots-delay 1 --enable-deepseek-v4-fp4-indexer --enable-cache-report --sleep-on-idle --prefill-decode-interval 4 --enable-metrics --decode-log-interval 10"

# NCCL connection buffers live in pinned host RAM, which on GB10 is GPU memory. The defaults cost
# ~4.7 GiB per node. Decode all-reduces are 61 KB (LL protocol); LL128 buys nothing here.
# Measured: 5.0 GB -> 0.14 GB pinned.
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_MAX_NCHANNELS=8
NCCL_DEBUG=WARN
NCCL_DEBUG_SUBSYS=INIT,ENV

EXTRA_CONTAINER_ENV="DSV41_INDEXER_CHUNKED=1 SGLANG_DSPARK_FOLDED_SAMPLING=2 SGLANG_ROCE_ALLREDUCE=1 SGLANG_ROCE_MAX_SIZE=2097152 B12X_ROCE_HCA=rocep1s0f1,roceP2p1s0f1 B12X_ROCE_CACHE_DIR=/state/b12x-roce B12X_COMPILE_CACHE_DIR=/state/b12x-compile SPARK_PREFILL_TP_SPLIT=1 SPARK_PREFILL_TP_MIN_CONTEXT=32768 SPARK_PREFILL_TP_MIN_ROWS=1024 SGLANG_RUST_BUILD_MODE=never DSV41_ENGRAM_PREFETCH=1 SGLANG_RAGGED_VERIFY_MODE=compact"

SKIP_PREPARE=1
SKIP_VERIFY=1
SKIP_SMOKE=0
SMOKE_QUICK=1

{
  "id": "vllm-glm-5.3-flash-nvfp4-256k-2x",
  "engine": "vllm",
  "about": "GLM-5.3-Flash as miaai-lab runs it (MiaAI-Lab/GLM-5.3-Flash-NVFP4-Dual-DGX-Spark)",
  "image": null,
  "backend": "nvidia",
  "port": 8888,
  "entrypoint": [
    "bash",
    "/start.sh"
  ],
  "args": [
    "vllm",
    "serve",
    "${MODEL_DIR}",
    "--tensor-parallel-size",
    "2",
    "--distributed-executor-backend",
    "ray",
    "--tool-call-parser",
    "glm47",
    "--enable-auto-tool-choice",
    "--reasoning-parser",
    "glm45",
    "--host",
    "0.0.0.0",
    "--port",
    "8888",
    "--trust-remote-code",
    "--speculative-config",
    "{\"method\": \"mtp\", \"num_speculative_tokens\": 4}",
    "--max-model-len",
    "262144",
    "--gpu-memory-utilization",
    "0.84",
    "--block-size",
    "2304",
    "--max-num-seqs",
    "8",
    "--kv-cache-dtype",
    "fp8_e4m3",
    "--limit-mm-per-prompt",
    "{\"image\":4,\"video\":1}",
    "--skip-mm-profiling",
    "--chat-template",
    "${MODEL_DIR}/chat_template.jinja",
    "--enforce-eager",
    "--moe-backend",
    "marlin",
    "--enforce-eager",
    "--served-model-name",
    "LibertAIDAI/GLM-5.3-Flash-NVFP4"
  ],
  "env": {
    "NCCL_IB_DISABLE": "0",
    "NCCL_IB_ROCE_VERSION_NUM": "2",
    "NCCL_IB_GID_INDEX": "3",
    "NCCL_NET": "IB",
    "NCCL_NET_PLUGIN": "none",
    "NCCL_NVLS_ENABLE": "0",
    "NCCL_CUMEM_ENABLE": "0",
    "NCCL_IB_MERGE_NICS": "0",
    "NCCL_CROSS_NIC": "0",
    "NCCL_IGNORE_CPU_AFFINITY": "1",
    "NCCL_DEBUG": "WARN",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "TORCH_CUDA_ARCH_LIST": "12.1a",
    "FLASHINFER_CUDA_ARCH_LIST": "12.1a",
    "FLASHINFER_DISABLE_VERSION_CHECK": "1",
    "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
    "NCCL_SOCKET_IFNAME": "${CX7_IF}",
    "GLOO_SOCKET_IFNAME": "${CX7_IF}",
    "NCCL_IB_HCA": "${CX7_IB}",
    "LD_PRELOAD": "/nccl/libnccl.so.2.30.7",
    "VLLM_HOST_IP": "${NODE_IP}",
    "RAY_OBJECT_STORE_MEMORY": "4294967296",
    "VLLM_ENGINE_READY_TIMEOUT_S": "3600"
  },
  "shm": "32g",
  "weights": [
    {
      "repo": "LibertAIDAI/GLM-5.3-Flash-NVFP4",
      "revision": "caca4e6a4ebbd66f159d3d2fc256683fd6e27177",
      "at": "/root/.cache/huggingface",
      "layout": "hub"
    }
  ],
  "config": null,
  "ctx": 262144,
  "seqs": 1,
  "vision": true,
  "cards": 1,
  "build": {
    "repo": "MiaAI-Lab/GLM-5.3-Flash-NVFP4-Dual-DGX-Spark",
    "commit": "aed98a13ca75140d2691cc5c651ea5817d9a3e44",
    "dockerfile": "files/Dockerfile + files/Dockerfile.mm-ray"
  },
  "flags": [
    "--gpus all",
    "--network host",
    "--ipc=host",
    "--shm-size 32g",
    "--device /dev/infiniband",
    "--cap-add IPC_LOCK",
    "--ulimit memlock=-1",
    "--ulimit stack=67108864"
  ],
  "machines": 2,
  "setup": "Ray cluster (head ray start --head --port 6379 --object-store-memory 4GiB on spark1, worker joins from spark2) over direct CX7 QSFP RoCE link; host NCCL 2.30.7 .so in ~/nccl-2.30.7 bind-mounted to /nccl and LD_PRELOADed; passwordless ssh head->worker; weights rsynced to worker HF cache; chat_template.jinja refreshed from HF main (emit_image/emit_video); image built locally and docker save|load shipped to worker",
  "source": "https://github.com/MiaAI-Lab/GLM-5.3-Flash-NVFP4-Dual-DGX-Spark/tree/aed98a13ca75140d2691cc5c651ea5817d9a3e44"
}

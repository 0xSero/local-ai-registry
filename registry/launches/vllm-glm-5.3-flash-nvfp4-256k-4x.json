{
  "id": "vllm-glm-5.3-flash-nvfp4-256k-4x",
  "engine": "vllm",
  "about": "GLM-5.3-Flash (320B-A18B) NVFP4 + DFlash2 drafter as miaai-lab runs it (MiaAI-Lab/glm-5.3-flash-4x-dgx-spark-switchless)",
  "image": "radixark/vllm-glm53-flash:dflash2",
  "backend": "nvidia",
  "port": 8000,
  "entrypoint": null,
  "args": [
    "/model",
    "--served-model-name",
    "glm-5.3-flash",
    "--trust-remote-code",
    "--tensor-parallel-size",
    "4",
    "--nnodes",
    "4",
    "--node-rank",
    "${R}",
    "--master-addr",
    "${MASTER}",
    "--master-port",
    "${MPORT}",
    "--gpu-memory-utilization",
    "0.85",
    "--max-model-len",
    "262144",
    "--max-num-seqs",
    "6",
    "--max-num-batched-tokens",
    "8192",
    "--block-size",
    "2304",
    "--moe-backend",
    "marlin",
    "--kv-cache-dtype",
    "auto",
    "--kv-cache-memory",
    "12884901888",
    "--speculative-config",
    "{\"method\":\"dflash\",\"model\":\"/draft\",\"num_speculative_tokens\":7}",
    "--tool-call-parser",
    "glm47",
    "--enable-auto-tool-choice",
    "--reasoning-parser",
    "glm45",
    "--default-chat-template-kwargs",
    "{\"enable_thinking\": true}",
    "--distributed-executor-backend",
    "mp",
    "${TAIL}"
  ],
  "env": {
    "LD_PRELOAD": "/opt/patched-nccl/libnccl.so.2",
    "VLLM_NCCL_SO_PATH": "/opt/patched-nccl/libnccl.so.2",
    "NCCL_SKIP_TREE_CONNECT": "1",
    "NCCL_SOCKET_IFNAME": "${MGMT_IF}",
    "GLOO_SOCKET_IFNAME": "${MGMT_IF}",
    "VLLM_HOST_IP": "${MIP}",
    "NCCL_NET": "IB",
    "NCCL_IB_DISABLE": "0",
    "NCCL_IB_HCA": "${IB_HCA}",
    "NCCL_IB_GID_INDEX": "3",
    "NCCL_IB_SUBNET_PREFIX_LEN": "24",
    "NCCL_IB_SUBNET_AWARE_ROUTING": "1",
    "NCCL_ALGO": "Ring",
    "NCCL_PROTO": "LL,LL128,Simple",
    "NCCL_P2P_LEVEL": "SYS",
    "NCCL_MIN_NCHANNELS": "4",
    "NCCL_MAX_NCHANNELS": "4",
    "NCCL_CROSS_NIC": "1",
    "NCCL_CUMEM_ENABLE": "0",
    "NCCL_IGNORE_CPU_AFFINITY": "1",
    "NCCL_DEBUG": "WARN",
    "VLLM_ONE_GPU_PER_NODE": "1",
    "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "PYTHONUNBUFFERED": "1",
    "HF_HOME": "/cache/hf",
    "XDG_CACHE_HOME": "/cache",
    "VLLM_CACHE_ROOT": "/cache/vllm",
    "NODE_RANK": "${R}",
    "MASTER_ADDR": "${MASTER}",
    "TORCH_CUDA_ARCH_LIST": "12.1a",
    "FLASHINFER_CUDA_ARCH_LIST": "12.1a"
  },
  "shm": "32g",
  "weights": [
    {
      "repo": "LibertAIDAI/GLM-5.3-Flash-NVFP4",
      "revision": "caca4e6a4ebbd66f159d3d2fc256683fd6e27177",
      "at": "/model",
      "layout": "dir"
    }
  ],
  "config": null,
  "ctx": 262144,
  "seqs": 1,
  "vision": false,
  "cards": 1,
  "flags": [
    "--network host",
    "--ipc host",
    "--gpus all",
    "--cap-add IPC_LOCK",
    "--ulimit memlock=-1:-1",
    "--device /dev/infiniband:/dev/infiniband",
    "--restart no"
  ],
  "machines": 4,
  "setup": "4 Sparks cabled as a switchless dual-rail RoCE ring; run scripts/fabric-setup.sh (MTU 9000, routes, DOCKER-USER forwarding) after every reboot/docker churn; user must build/provide patched NCCL 2.30.7 (skip-tree-connect) at $HOME/nccl-patched/libnccl.so.2 on each node, mounted at /opt/patched-nccl; download weights to $HOME/glm53-flash-nvfp4 and drafter incoai/GLM-5.3-Flash-DFlash2 to $HOME/glm53-dflash2-draft; cache dir $HOME/glm53-tp4-cache -> /cache. Launch ranks 3,2,1 then 0.",
  "source": "https://github.com/MiaAI-Lab/glm-5.3-flash-4x-dgx-spark-switchless/tree/2b92a8f62e6f73b5a0268198a01e29b280db0e06"
}

  "metadata": {
    "localmaxxing": {
      "backend": null,
      "batch_size": 1,
      "hardware_label": "RTX 3080",
      "notes": "Full 262144-token native context, fully GPU-resident on a 10GB card. This model is a hybrid: qwen35.full_attention_interval=4, so only 8 of 32 layers carry a growing KV cache and the rest are SSM with constant state. Measured KV cost is 14.0 KiB/token at q4_0 (consistent to 3 significant figures across five context sizes from 128K to 262K), roughly a quarter of what a dense 32-layer 9B would need. At 262K the model sits at 9691 MiB peak with 408 MiB host-shared, which is the normal baseline here rather than spill: decode holds at 92 tok/s and PCIe rx stays near 100 MB/s. Q6_K of the same model does NOT fit 262K on this card (1306 MiB host-shared, decode halves to 42 tok/s), so Q5_K_M is the right pick at max context. Decode figure is the median of 3 reps, not the best. Prompt is deliberately non-repetitive: a repeated-sentence filler inflates decode by ~25% on speculative setups. ignore_eos is set so output token count is identical across runs.",
      "observed_command": "llama-server \\\n  -m Ornith-1.5-9B-Q5_K_M.gguf \\\n  --host 127.0.0.1 \\\n  --port 8099 \\\n  --device CUDA0 \\\n  --n-gpu-layers 99 \\\n  --ctx-size 262144 \\\n  --flash-attn on \\\n  --cache-type-k q4_0 \\\n  --cache-type-v q4_0 \\\n  --parallel 1 \\\n  --jinja \\\n  --spec-type none",

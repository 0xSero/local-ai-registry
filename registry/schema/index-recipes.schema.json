{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-ai-registry.dev/schema/index-recipes.schema.json",
  "title": "Registry recipes index",
  "description": "registry/index/recipes.json: compact recipe rows for filtering without fetching full records.",
  "type": "object",
  "required": [
    "schema_version",
    "recipes"
  ],
  "properties": {
    "schema_version": {
      "const": "local-ai-registry/v1"
    },
    "recipes": {
      "type": "array",
      "items": {
        "title": "Index recipe row",
        "type": "object",
        "required": [
          "id",
          "model_instance_id",
          "hardware_id",
          "hardware_count",
          "engine",
          "status",
          "recipe_source",
          "launch_kind",
          "has_evidence",
          "capabilities"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "model_instance_id": {
            "type": "string"
          },
          "hardware_id": {
            "type": "string"
          },
          "hardware_count": {
            "type": "integer",
            "minimum": 1
          },
          "engine": {
            "type": "string"
          },
          "status": {
            "enum": [
              "candidate",
              "validated"
            ]
          },
          "recipe_source": {
            "type": "string"
          },
          "launch_kind": {
            "enum": [
              "reference",
              "docker",
              "docker-compose",
              "controller",
              "script",
              "native"
            ]
          },
          "has_evidence": {
            "type": "boolean"
          },
          "capabilities": {
            "type": "object",
            "required": [
              "chat",
              "reasoning",
              "tools",
              "vision"
            ],
            "properties": {
              "chat": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "reasoning": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "tools": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "vision": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-ai-registry.dev/schema/price.schema.json",
  "title": "Price record",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "product",
    "region",
    "hardware",
    "observed_at",
    "summary",
    "observations",
    "verification",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "local-ai-registry/v1"
    },
    "id": {
      "type": "string"
    },
    "product": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        }
      }
    },
    "region": {
      "type": "object",
      "required": [
        "code",
        "name",
        "currency"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        }
      }
    },
    "hardware": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "match_scope"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "match_scope": {
            "enum": [
              "exact",
              "family"
            ]
          }
        }
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "title": "Price summary",
      "type": "object",
      "required": [
        "listing_count",
        "retailer_count",
        "in_stock_count",
        "lowest_new",
        "lowest_refurbished",
        "lowest_used"
      ],
      "properties": {
        "listing_count": {
          "type": "integer",
          "minimum": 0
        },
        "retailer_count": {
          "type": "integer",
          "minimum": 0
        },
        "in_stock_count": {
          "type": "integer",
          "minimum": 0
        },
        "lowest_new": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "lowest_refurbished": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "lowest_used": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "title": "Price observation",
        "type": "object",
        "required": [
          "retailer",
          "title",
          "condition",
          "amount",
          "currency",
          "in_stock",
          "quantity",
          "url",
          "observed_at"
        ],
        "properties": {
          "retailer": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "condition": {
            "enum": [
              "new",
              "refurbished",
              "used",
              "unknown"
            ]
          },
          "amount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "minLength": 1
          },
          "in_stock": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "quantity": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "url": {
            "type": "string",
            "format": "iri"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "title": "Price verification",
      "type": "object",
      "required": [
        "state",
        "method",
        "rejected_observations"
      ],
      "properties": {
        "state": {
          "enum": [
            "candidate",
            "validated"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "rejected_observations": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "title": "Price provenance",
      "type": "object",
      "required": [
        "scanner",
        "snapshot_generated_at",
        "source_error_count"
      ],
      "properties": {
        "scanner": {
          "type": "string",
          "format": "uri"
        },
        "snapshot_generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_error_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "Regional market price record: retailer observations for one product in one region."
}

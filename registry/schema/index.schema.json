{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-ai-registry.dev/schema/index.schema.json",
  "title": "Registry collections index",
  "type": "object",
  "required": [
    "schema_version",
    "resolver_rule",
    "collections",
    "counts"
  ],
  "properties": {
    "schema_version": {
      "const": "local-ai-registry/v1"
    },
    "resolver_rule": {
      "type": "string"
    },
    "collections": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "additionalProperties": false,
  "description": "registry/index/collections.json: collection id lists and counts. Compact recipe rows live in index/recipes.json; reverse lookups in the sibling *-by-* shards."
}

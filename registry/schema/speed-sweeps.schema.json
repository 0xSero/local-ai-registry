{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-ai-registry.dev/schema/speed-sweeps.schema.json",
  "title": "Speed sweep",
  "type": "object",
  "required": ["schema_version", "id", "recipe_id", "measured_at", "accepted_at", "source", "rows"],
  "properties": {
    "schema_version": { "const": "local-ai-registry/v1" },
    "id": { "type": "string" },
    "recipe_id": { "type": "string" },
    "measured_at": { "type": ["string", "null"] },
    "accepted_at": { "type": ["string", "null"] },
    "source": { "type": ["object", "null"] },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["concurrency", "context_tokens", "output_tokens", "prefill_tok_s", "decode_tok_s", "ttft_ms_p50", "peak_vram_gb", "samples", "status"],
        "properties": {
          "concurrency": { "type": ["integer", "null"], "minimum": 1 },
          "context_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
          "prefill_tok_s": { "type": ["number", "null"], "minimum": 0 },
          "decode_tok_s": { "type": ["number", "null"], "minimum": 0 },
          "decode_tok_s_per_stream": { "type": ["number", "null"], "minimum": 0 },
          "ttft_ms_p50": { "type": ["number", "null"], "minimum": 0 },
          "peak_vram_gb": { "type": ["number", "null"], "minimum": 0 },
          "samples": { "type": ["integer", "null"], "minimum": 1 },
          "status": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}

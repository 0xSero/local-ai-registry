{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-ai-registry.dev/schema/recipe.schema.json",
  "title": "Recipe",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "recipe_source",
    "status",
    "model_instance_id",
    "hardware_id",
    "hardware_count",
    "engine",
    "launch",
    "serving",
    "capabilities",
    "speed_sweep_ids",
    "metadata",
    "provenance",
    "facts"
  ],
  "properties": {
    "schema_version": {
      "const": "local-ai-registry/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "recipe_source": {
      "type": "string"
    },
    "status": {
      "enum": [
        "candidate",
        "validated"
      ]
    },
    "recommended": {
      "type": "boolean",
      "description": "Curator flag: the one recipe the Omarchy plugin ships for this hardware id. At most one per hardware id."
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_instance_id": {
      "type": "string"
    },
    "hardware_id": {
      "type": "string"
    },
    "hardware_count": {
      "type": "integer",
      "minimum": 1
    },
    "engine": {
      "type": "object",
      "required": [
        "name",
        "version",
        "graph_mode"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "graph_mode": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "launch": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "reference",
            "docker",
            "docker-compose",
            "controller",
            "script",
            "native"
          ]
        },
        "container": {
          "$ref": "common.schema.json#/$defs/container"
        }
      },
      "additionalProperties": true
    },
    "serving": {
      "type": "object"
    },
    "capabilities": {
      "type": "object",
      "required": [
        "chat",
        "reasoning",
        "tools",
        "vision"
      ],
      "properties": {
        "chat": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reasoning": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tools": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "vision": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "facts": {
      "$ref": "common.schema.json#/$defs/facts"
    },
    "speed_sweep_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "draft_launch": {
      "type": "object",
      "description": "Synthesized, UNVERIFIED docker launch draft used only by the acceptance harness (local-ai validate). Never a launch contract: the observed launch stays authoritative until acceptance promotes the recipe, at which point draft_launch becomes launch and is removed.",
      "required": [
        "kind",
        "image",
        "arguments",
        "host_port",
        "container_port",
        "accelerator_backend",
        "synthesized"
      ],
      "properties": {
        "kind": {
          "const": "docker"
        },
        "image": {
          "type": "string",
          "pattern": "@sha256:[0-9a-f]{64}$"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entrypoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "mounts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "target"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "read_only": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "host_port": {
          "type": "integer"
        },
        "container_port": {
          "type": "integer"
        },
        "ipc": {
          "type": "string"
        },
        "shm_size": {
          "type": "string"
        },
        "accelerator_backend": {
          "type": "string"
        },
        "synthesized": {
          "type": "object",
          "required": [
            "template",
            "generated_at",
            "image_provenance"
          ],
          "properties": {
            "template": {
              "type": "string"
            },
            "generated_at": {
              "type": "string",
              "format": "date-time"
            },
            "image_provenance": {
              "type": "string",
              "description": "Which audited registry recipe this image digest was taken from."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "recipe_source": {
            "const": "localmaxxing"
          }
        },
        "required": [
          "recipe_source"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "candidate"
          },
          "launch": {
            "properties": {
              "kind": {
                "const": "reference"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recipe_source": {
            "const": "mlxfast"
          }
        },
        "required": [
          "recipe_source"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "candidate"
          },
          "hardware_id": {
            "const": "apple-m5-max-128gb"
          },
          "launch": {
            "properties": {
              "kind": {
                "const": "reference"
              }
            },
            "required": [
              "kind"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "validated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "launch": {
            "not": {
              "properties": {
                "kind": {
                  "const": "reference"
                }
              },
              "required": [
                "kind"
              ]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}

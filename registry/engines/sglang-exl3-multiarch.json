{
  "id": "sglang-exl3-multiarch",
  "engine": "sglang",
  "about": "SGLang 0.5.20 with EXL3 kernels (0xSero/sglang-exl3 v0.7.0) recompiled for sm_86, sm_89 and sm_120: Ampere, Ada and consumer Blackwell. EXL3 weights, OpenAI chat API",
  "image": "ghcr.io/0xsero/sglang-exl3:v0.7.0-multiarch@sha256:9d95829ab41a9307e9b25c86e4af1ec52c6a02f7888f0e13a1ce93c0a7ff3814",
  "backend": "nvidia",
  "min_cuda": 13.0,
  "port": 30000,
  "entrypoint": "/opt/entrypoint.sh",
  "args": [
    "python3",
    "-m",
    "sglang.launch_server",
    "--model-path",
    "/models/${name}",
    "--quantization",
    "exl3",
    "--trust-remote-code",
    "--host",
    "0.0.0.0",
    "--port",
    "30000",
    "--served-model-name",
    "${name}",
    "--context-length",
    "${ctx}",
    "--mem-fraction-static",
    "${mem}",
    "--kv-cache-dtype",
    "${kv}",
    "--max-running-requests",
    "${seqs}",
    "--chunked-prefill-size",
    "${chunk}",
    "--max-prefill-tokens",
    "${chunk}",
    "--reasoning-parser",
    "${think}",
    "--tool-call-parser",
    "${tools}",
    "${extra}"
  ],
  "env": {
    "CUDA_DEVICE_ORDER": "PCI_BUS_ID",
    "HF_HUB_OFFLINE": "1",
    "SGLANG_EXL3_EMBED_HOST": "1",
    "SGLANG_EXL3_KERNEL": "auto",
    "SGLANG_EXL3_MODEL_PATH": "/models/${name}"
  },
  "shm": "16g",
  "weights_at": "/models/${name}",
  "defaults": {
    "ctx": 32768,
    "seqs": 1,
    "mem": 0.8,
    "kv": "fp8_e4m3",
    "tools": "qwen3_coder",
    "think": "qwen3",
    "vision": false,
    "extra": "",
    "chunk": 1024,
    "pool": 0
  }
}

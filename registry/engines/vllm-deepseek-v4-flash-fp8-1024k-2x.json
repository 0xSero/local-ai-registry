{
  "id": "vllm-deepseek-v4-flash-fp8-1024k-2x",
  "engine": "vllm",
  "about": "DeepSeek-V4-Flash-Vision-Exp as miaai-lab runs it (MiaAI-Lab/DeepSeek-v4-Flash-DSpark-2x-DGX-Spark)",
  "image": "ghcr.io/anemll/dspark-vllm-gx10:0.1.1@sha256:a83948492cf13df455170fb42885f5ef4db54fefe0feff0f841ecbff464ac9d8",
  "backend": "nvidia",
  "port": 8888,
  "entrypoint": [
    "/usr/local/bin/vllm",
    "serve"
  ],
  "args": [
    "deepseek-ai/DeepSeek-V4-Flash-Vision-Exp",
    "--revision",
    "86f746b36186f0e567729a5c06a8c918caba82a9",
    "--served-model-name",
    "deepseek-v4-flash-vision-exp",
    "--host",
    "0.0.0.0",
    "--port",
    "8888",
    "--trust-remote-code",
    "--tensor-parallel-size",
    "2",
    "--pipeline-parallel-size",
    "1",
    "--kv-cache-dtype",
    "nvfp4_ds_mla",
    "--block-size",
    "256",
    "--max-model-len",
    "1048576",
    "--max-num-seqs",
    "6",
    "--max-num-batched-tokens",
    "8192",
    "--long-prefill-token-threshold",
    "1024",
    "--max-cudagraph-capture-size",
    "48",
    "--gpu-memory-utilization",
    "0.835",
    "--enable-prefix-caching",
    "--enable-prompt-tokens-details",
    "--async-scheduling",
    "--enable-chunked-prefill",
    "--speculative-config",
    "{\"method\":\"dspark\",\"num_speculative_tokens\":6,\"draft_sample_method\":\"probabilistic\"}",
    "--tokenizer-mode",
    "deepseek_v4",
    "--limit-mm-per-prompt",
    "{\"image\":8}",
    "--distributed-executor-backend",
    "mp",
    "--moe-backend",
    "flashinfer_b12x",
    "--tool-call-parser",
    "deepseek_v4",
    "--enable-auto-tool-choice",
    "--reasoning-parser",
    "deepseek_v4",
    "--reasoning-config",
    "{\"reasoning_parser\":\"deepseek_v4\",\"reasoning_start_str\":\"<think>\",\"reasoning_end_str\":\"</think>\"}",
    "--default-chat-template-kwargs",
    "{\"thinking\":true,\"reasoning_effort\":\"low\"}",
    "--generation-config",
    "vllm",
    "--enable-flashinfer-autotune",
    "--nnodes",
    "2",
    "--node-rank",
    "${NODE_RANK}",
    "--master-addr",
    "${MASTER_ADDR}",
    "--master-port",
    "25000",
    "${HEADLESS:+--headless}"
  ],
  "env": {
    "HF_HOME": "/cache/huggingface",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_HUB_DISABLE_XET": "1",
    "DSPARK_MODEL": "deepseek-ai/DeepSeek-V4-Flash-Vision-Exp",
    "DSPARK_REVISION": "86f746b36186f0e567729a5c06a8c918caba82a9",
    "VLLM_PREFIX_CACHE_RETENTION_INTERVAL": "4096",
    "DSPARK_MAX_INFLIGHT_PREFILLS": "1",
    "VLLM_CACHE_ROOT": "/cache/huggingface/vllm-cache",
    "VLLM_HOST_IP": "${VLLM_HOST_IP}",
    "VLLM_ALLOW_LONG_MAX_MODEL_LEN": "1",
    "VLLM_SPARSE_INDEXER_MAX_LOGITS_MB": "256",
    "VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS": "0",
    "VLLM_USE_FLASHINFER_SAMPLER": "1",
    "VLLM_USE_BREAKABLE_CUDAGRAPH": "0",
    "VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS": "1800",
    "VLLM_USE_B12X_MOE": "1",
    "VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM": "0",
    "VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M": "16",
    "TORCH_CUDA_ARCH_LIST": "12.1a",
    "FLASHINFER_CUDA_ARCH_LIST": "12.1a",
    "CUTE_DSL_ARCH": "sm_121a",
    "FLASHINFER_DISABLE_VERSION_CHECK": "1",
    "FLASHINFER_WORKSPACE_BASE": "/cache/huggingface/flashinfer",
    "TILELANG_CLEANUP_TEMP_FILES": "1",
    "TILELANG_CACHE_DIR": "/cache/huggingface/tilelang-cache",
    "TRITON_CACHE_DIR": "/cache/huggingface/triton-cache",
    "TORCH_FR_BUFFER_SIZE": "2000",
    "TORCH_NCCL_DUMP_ON_TIMEOUT": "1",
    "TORCH_NCCL_ENABLE_MONITORING": "1",
    "B12X_CUTE_COMPILE_CACHE_DIR": "/cache/huggingface/b12x-cute-cache",
    "DG_JIT_USE_NVRTC": "0",
    "DG_JIT_NVCC_COMPILER": "/usr/local/cuda/bin/nvcc",
    "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
    "NCCL_NET": "IB",
    "NCCL_IB_DISABLE": "0",
    "NCCL_IB_HCA": "${NCCL_IB_HCA}",
    "NCCL_SOCKET_IFNAME": "${NCCL_SOCKET_IFNAME}",
    "TP_SOCKET_IFNAME": "${NCCL_SOCKET_IFNAME}",
    "GLOO_SOCKET_IFNAME": "${NCCL_SOCKET_IFNAME}",
    "NCCL_IB_GID_INDEX": "${NCCL_IB_GID_INDEX}",
    "NCCL_IB_ADDR_FAMILY": "AF_INET",
    "NCCL_IB_ROCE_VERSION_NUM": "2",
    "NCCL_CROSS_NIC": "1",
    "NCCL_CUMEM_ENABLE": "0",
    "NCCL_IGNORE_CPU_AFFINITY": "1",
    "NCCL_DEBUG": "WARN",
    "NCCL_NVLS_ENABLE": "0",
    "NODE_RANK": "${NODE_RANK}",
    "HEADLESS": "${HEADLESS}",
    "TP_SIZE": "2",
    "NNODES": "2",
    "MASTER_ADDR": "${MASTER_ADDR}",
    "MASTER_PORT": "25000",
    "MTP_NUM_TOKENS": "6",
    "DRAFT_SAMPLE_METHOD": "probabilistic",
    "DEFAULT_THINKING": "low",
    "DSPARK_ASYNC_SCHEDULING": "1",
    "DSPARK_SUPPRESS_STOPS_IN_REASONING": "1",
    "GPU_MEMORY_UTILIZATION": "0.835"
  },
  "shm": "64gb",
  "weights": [
    {
      "repo": "deepseek-ai/DeepSeek-V4-Flash-Vision-Exp",
      "revision": "86f746b36186f0e567729a5c06a8c918caba82a9",
      "at": "/cache/huggingface",
      "layout": "hub"
    }
  ],
  "config": null,
  "ctx": 1048576,
  "seqs": 1,
  "vision": true,
  "cards": 1,
  "flags": [
    "--network host",
    "--ipc host",
    "--gpus all",
    "--device /dev/infiniband",
    "--ulimit memlock=-1",
    "--ulimit stack=67108864"
  ],
  "machines": 2,
  "setup": "docker compose run per node (rank 1 headless worker first, then head rank 0) via start-deepseek-v4-flash-dspark.sh over SSH; RoCE/NCCL over ConnectX-7 (NCCL_IB_HCA, socket ifnames, GID index auto-resolved); ~25 Python hotfixes from patches/ bind-mounted and applied at container start; weights on both nodes (prepare-dspark-model-cache.sh) or worker over NFSv4 (DSPARK_WORKER_HF_NFS=1); disable earlyoom",
  "source": "https://github.com/MiaAI-Lab/DeepSeek-v4-Flash-DSpark-2x-DGX-Spark/tree/97e8733238f81f5fdc44b241f8996a7858825744"
}

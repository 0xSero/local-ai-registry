  "shm": "32g",
  "weights": [
    {
      "repo": "poolside/Laguna-S-2.1-NVFP4",
      "revision": "826aacdf6d8b2699d4e367def6f17c83b06044c2",
      "at": "/root/.cache/huggingface",
      "layout": "hub"
    }
  ],
  "config": null,
  "ctx": 262144,
  "seqs": 1,
  "vision": false,
  "cards": 1,
  "flags": [
    "--user root",
    "--network host",
    "--shm-size=32g",
    "--ulimit memlock=-1:-1",
    "--cap-add=IPC_LOCK",
    "--ipc host",
    "--gpus all",
    "--workdir /workspace"
  ],
  "setup": "Container entrypoint is a bootstrap script written to /tmp/laguna-bootstrap.sh on the host and mounted at /bootstrap.sh:ro. It pip-installs the FlashInfer nightly trio 0.6.15.dev20260712 (+cu130 jit-cache) plus cuda-tile 1.5.0 and nccl4py 0.3.1 at every cold start, then execs 'vllm serve \"$@\"' (needs internet access to flashinfer.ai). Mounts ~/.cache/huggingface, ~/.cache/flashinfer -> /root/.cache/flashinfer (persistent JIT cache), and the repo dir -> /workspace. Both target and draft downloaded on host (hf/huggingface-cli/docker fallback). First start about 15 min.",
  "source": "https://github.com/MiaAI-Lab/Laguna-S-2.1-DGX-Spark-RTX-6000-PRO/tree/750a52ead5e92d4f8c2b42321c6695bcc3cf6360"

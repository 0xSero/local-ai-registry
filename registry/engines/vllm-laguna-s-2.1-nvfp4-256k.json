{
  "id": "vllm-laguna-s-2.1-nvfp4-256k",
  "engine": "vllm",
  "about": "Laguna-S-2.1 NVFP4 (DFlash) as miaai-lab runs it (MiaAI-Lab/Laguna-S-2.1-DGX-Spark-RTX-6000-PRO)",
  "image": "vllm/vllm-openai:v0.25.1@sha256:e4f88a835143cd22aee2397a26ec6bb80b3a4a6fe0c882bcbc63822904766089",
  "backend": "nvidia",
  "port": 8888,
  "entrypoint": [
    "/bootstrap.sh"
  ],
  "args": [
    "poolside/Laguna-S-2.1-NVFP4",
    "--host",
    "0.0.0.0",
    "--port",
    "8888",
    "--tensor-parallel-size",
    "1",
    "--dtype",
    "bfloat16",
    "--attention-backend",
    "FLASHINFER",
    "--trust-remote-code",
    "--gpu-memory-utilization",
    "0.85",
    "--max-model-len",
    "262144",
    "--max-num-seqs",
    "4",
    "--max-num-batched-tokens",
    "8192",
    "--enable-auto-tool-choice",
    "--tool-call-parser",
    "poolside_v1",
    "--reasoning-parser",
    "poolside_v1",
    "--default-chat-template-kwargs",
    "{\"enable_thinking\":true}",
    "--override-generation-config",
    "{\"temperature\":0.7,\"top_p\":0.95,\"top_k\":20}",
    "--speculative-config",
    "{\"model\":\"poolside/Laguna-S-2.1-DFlash-NVFP4\",\"num_speculative_tokens\":7,\"method\":\"dflash\"}"
  ],
  "env": {
    "VLLM_TARGET_DEVICE": "cuda",
    "VLLM_TRUST_REMOTE_CODE": "1",
    "CUTE_DSL_ARCH": "sm_121a",
    "MAX_JOBS": "4",
    "NVCC_THREADS": "2",
    "FLASHINFER_NVCC_THREADS": "2",
    "PATH": "/usr/local/cuda/bin:${PATH}",
    "HF_HOME": "/root/.cache/huggingface",
    "HF_TOKEN": "${HF_TOKEN:-}"

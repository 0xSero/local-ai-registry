{
  "id": "tabbyapi-exl3",
  "about": "TabbyAPI on ExLlamaV3 1.5.1, attested build of 0xSero/local-ai-images tabbyapi-exl3; EXL3 weights, OpenAI chat API",
  "image": "ghcr.io/0xsero/tabbyapi-exl3@sha256:0f83e6198dc3be2561652d8df2525a7d1a69733e12fc8e25cbc5bc319a8a3ad1",
  "backend": "nvidia",
  "min_cuda": 13.2,
  "port": 5000,
  "entrypoint": "/opt/venv/bin/python3",
  "args": [
    "main.py",
    "--config",
    "/app/config.yml"
  ],
  "shm": "8g",
  "weights_at": "/workspace/models/${name}",
  "config_at": "/app/config.yml",
  "defaults": {
    "ctx": 32768,
    "seqs": 1,
    "cache": "Q4",
    "draft": "none",
    "think": "auto",
    "tools": "qwen3_coder",
    "vision": false
  },
  "config": [
    "network: {host: 0.0.0.0, port: 5000, disable_auth: true, disable_fetch_requests: true, send_tracebacks: false, api_servers: [OAI], sse_ping_interval: 15}",
    "logging: {log_prompt: false, log_generation_params: false, log_requests: false, log_chat_completion_requests: false}",
    "model:",
    "  model_dir: /workspace/models",
    "  model_name: ${name}",
    "  backend: exllamav3",
    "  inline_model_loading: false",
    "  max_seq_len: ${ctx}",
    "  cache_size: ${cache_tokens}",
    "  cache_mode: ${cache}",
    "  tensor_parallel: false",
    "  gpu_split_auto: true",
    "  autosplit_reserve: [256]",
    "  chunk_size: 2048",
    "  output_chunking: true",
    "  max_batch_size: ${seqs}",
    "  vision: ${vision}",
    "  reasoning: true",
    "  start_in_reasoning: ${think}",
    "  tool_format: ${tools}",
    "draft_model: ${draft_block}",
    "memory: {sysmem_recurrent_cache: 4096, sysmem_kv_cache: 0, cuda_malloc_async: true}"
  ],
  "engine": "tabbyapi"
}

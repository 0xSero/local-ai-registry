    "--mm-encoder-tp-mode",
    "data",
    "--nnodes",
    "2",
    "--master-addr",
    "${HEAD_IP}",
    "--master-port",
    "50000",
    "--enable-expert-parallel",
    "--all2all-backend",
    "allgather_reducescatter",
    "--speculative-config",
    "{\"method\":\"mtp\",\"num_speculative_tokens\":3,\"use_local_argmax_reduction\":true}",
    "--compilation-config",
    "{\"mode\":0,\"cudagraph_mode\":\"FULL_DECODE_ONLY\"}",
    "--hf-overrides",
    "{\"text_config\":{\"ple_embedding_dtype\":\"${PLE_EMBEDDING_DTYPE}\"}}",
    "--node-rank",
    "${NODE_RANK}"
  ],
  "env": {
    "GLOO_SOCKET_IFNAME": "${IFACE}",
    "NCCL_SOCKET_IFNAME": "${IFACE}",
    "TP_SOCKET_IFNAME": "${IFACE}",
    "NCCL_IB_DISABLE": "0",
    "NCCL_IB_HCA": "${IB_HCA}",
    "NCCL_IB_GID_INDEX": "3",
    "NCCL_IB_AUTO_DETECT": "0",
    "NCCL_DEBUG": "WARN",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "VLLM_HOST_IP": "${NODE_IP}",
    "VLLM_ALLOW_LONG_MAX_MODEL_LEN": "1",
    "HF_HOME": "/root/.cache/huggingface",
    "VLLM_MTP_DRAFT_VOCAB": "/etc/vllm-draft-vocab.txt"
  },
  "shm": null,
  "weights": [
    {
      "repo": "nvidia/Qwen3.8-Flash-Next-NVFP4",
      "revision": "fc694b54fb0174e0913e6adf86691ef85a4ead47",
      "at": "/root/.cache/huggingface",
      "layout": "hub"
    }
  ],
  "config": null,
  "ctx": 262144,
  "seqs": 1,
  "vision": true,
  "cards": 1,
  "flags": [
    "--gpus all",
    "--network host",
    "--ipc host",
    "--cap-add SYS_NICE",
    "--ulimit memlock=-1",
    "--ulimit stack=67108864",
    "--device /dev/infiniband:/dev/infiniband"
  ],
  "machines": 2,
  "setup": "Passwordless SSH head->worker, ConnectX RoCE link (IFACE/IB_HCA in .env). start.sh rsyncs (or NFS-shares) weights to worker, extracts and patches vLLM files from the image (ple_layer.py, modelopt.py for MXFP8 + FP8_BLOCK_SCALES MTP experts, mtp.py draft vocab), patches checkpoint config (mtp.layers.48 alias) and bind-mounts them ro; evicts checkpoint page cache before launch. Worker (rank 1, --headless) starts first, head (rank 0) serves.",
  "source": "https://github.com/MiaAI-Lab/Qwen3.8-Flash-Next-Dual-DGX-Sparks/tree/d2f54b78c0d2f9d74ac61aa56200e3c40fac3f22"

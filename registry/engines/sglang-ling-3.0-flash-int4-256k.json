{
  "id": "sglang-ling-3.0-flash-int4-256k",
  "engine": "sglang",
  "about": "Ling-3.0-flash INT4 + DSpark draft as miaai-lab runs it (MiaAI-Lab/Ling-3.0-Flash-SGLang-DSpark-DGX-Spark)",
  "image": "lmsysorg/sglang:dev-Ling-3.0-flash@sha256:880d81d428e73aaad8eb944e33556951d17f9deaeba661803da5d391052840b6",
  "backend": "nvidia",
  "port": 8888,
  "entrypoint": [
    "/bootstrap.sh"
  ],
  "args": [
    "--model-path",
    "${MODEL_PATH_IN_CONTAINER}",
    "--trust-remote-code",
    "--nnodes",
    "1",
    "--dist-init-addr",
    "127.0.0.1:2345",
    "--host",
    "${HOST}",
    "--port",
    "${PORT}",
    "--tp-size",
    "1",
    "--ep-size",
    "1",
    "--random-seed",
    "308534008",
    "--max-running-requests",
    "${MAX_RUNNING_REQUESTS:-6}",
    "--max-mamba-cache-size",
    "${MAX_MAMBA_CACHE_SIZE:-32}",
    "--chunked-prefill-size",
    "8192",
    "--allow-auto-truncate",
    "--context-length",
    "${CTX}",
    "--mem-fraction-static",
    "${MEM_FRACTION_STATIC:-0.75}",
    "--tool-call-parser",
    "ling3",
    "--reasoning-parser",
    "ling3",
    "--enable-fp32-lm-head",
    "--disable-shared-experts-fusion",
    "--kv-cache-dtype",
    "${KV_CACHE_DTYPE:-fp8_e4m3}",
    "--speculative-algorithm",
    "DSPARK",
    "--speculative-draft-model-path",
    "${DSPARK_PATH_IN_CONTAINER}",
    "--enable-linear-replayssm-spec",
    "--linear-replayssm-cache-len",
    "${REPLAYSSM_CACHE_LEN}"
  ],
  "env": {
    "SGLANG_ALLOW_OVERWRITE_LONGER_CONTEXT_LEN": "1",
    "SGLANG_JIT_DEEPGEMM_PRECOMPILE": "1",
    "SGLANG_ENABLE_SPEC_V2": "1",
    "FLASHINFER_DISABLE_VERSION_CHECK": "1",
    "HF_HOME": "/root/.cache/huggingface",
    "HF_TOKEN": "${HF_TOKEN:-}",
    "GITHUB_TOKEN": "${GITHUB_TOKEN:-}"
  },
  "shm": "32g",
  "weights": [
    {
      "repo": "inclusionAI/Ling-3.0-flash-int4",
      "revision": "7a27e9eb8179b2c2eb71eb214f0dab14ec6a63f2",
      "at": "/root/.cache/huggingface",
      "layout": "hub"
    }
  ],
  "config": null,
  "ctx": 262144,
  "seqs": 1,
  "vision": false,
  "cards": 1,
  "flags": [
    "--user root",
    "--network host",
    "--ipc host",
    "--gpus all",
    "--ulimit memlock=-1:-1",
    "--cap-add=IPC_LOCK",
    "--workdir /workspace",
    "-v ${BOOTSTRAP_SCRIPT}:/bootstrap.sh:ro",
    "-v ${HF_HOME}:/root/.cache/huggingface",
    "-v ${FLASHINFER_CACHE_DIR}:/root/.cache/flashinfer",
    "-v ${WORK_DIR}:/workspace"
  ],
  "setup": "./start.sh --download-only caches weights + draft in $HF_HOME (hf/huggingface-cli or docker fallback); start.sh writes /tmp/ling-bootstrap.sh on the host and mounts it as the entrypoint (runs `sglang serve` or `python -m sglang.launch_server` with the args).",
  "source": "https://github.com/MiaAI-Lab/Ling-3.0-Flash-SGLang-DSpark-DGX-Spark/tree/ca840cb8d032353e24648aeee06312b0938348f6"
}

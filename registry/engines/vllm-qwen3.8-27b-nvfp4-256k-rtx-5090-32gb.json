{
  "id": "vllm-qwen3.8-27b-nvfp4-256k-rtx-5090-32gb",
  "kind": "host",
  "engine": "vllm",
  "about": "Qwen3.8-27B as miaai-lab runs it (MiaAI-Lab/Qwen3.8-27B-NVFP4-RTX-5090)",
  "command": [
    ".venv/bin/vllm",
    "serve",
    "$HOME/models/RadixArk/Qwen3.8-27B-NVFP4",
    "--served-model-name",
    "qwen38-nvfp4",
    "--host",
    "0.0.0.0",
    "--port",
    "8888",
    "--max-model-len",
    "262144",
    "--kv-cache-dtype",
    "turboquant_4bit_nc",
    "--kv-cache-memory-bytes",
    "5905580032",
    "--max-num-seqs",
    "1",
    "--max-num-batched-tokens",
    "512",
    "--gpu-memory-utilization",
    "$GPU_UTIL",
    "--attention-config.flash_attn_version=2",
    "--enable-auto-tool-choice",
    "--tool-call-parser",
    "qwen3_xml",
    "--reasoning-parser",
    "qwen3",
    "--speculative-config",
    "{\"method\":\"mtp\",\"num_speculative_tokens\":3}"
  ],
  "env": {
    "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
    "VLLM_USE_FLASHINFER_SAMPLER": "0"
  },
  "install": "https://github.com/MiaAI-Lab/Qwen3.8-27B-NVFP4-RTX-5090/tree/a5f9bff97796989b2f3629a2cf0d8335eca7a7e8",
  "port": 8888,
  "ctx": 262144,
  "seqs": 1,
  "vision": false,
  "backend": "nvidia",
  "setup": "Not Docker. start.sh: python3 -m venv .venv; pip install vllm==0.27.1 flashinfer-python>=0.6.13 nvidia-cutlass-dsl>=4.5.2; apply PR #40914 backport; snapshot_download RadixArk/Qwen3.8-27B-NVFP4 to MODEL_DIR (~22 GiB); if <Python.h> missing, installs uv CPython 3.14 and sets CC=~/.local/bin/cc-triton; GPU_UTIL auto = (free MiB - 820)/total clamped [0.80,0.98]; runs vllm serve with nohup, waits for /v1/models, then warms with a ~26K-token prefill. No CUDA toolkit needed.",
  "source": "https://github.com/MiaAI-Lab/Qwen3.8-27B-NVFP4-RTX-5090/tree/a5f9bff97796989b2f3629a2cf0d8335eca7a7e8"
}

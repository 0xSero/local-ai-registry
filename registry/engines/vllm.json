{
  "id": "vllm",
  "engine": "vllm",
  "about": "vLLM 0.30.0, the upstream image; NVFP4, FP8, AWQ/GPTQ and BF16 weights, OpenAI chat API",
  "image": "vllm/vllm-openai:v0.30.0@sha256:8a69ffad015f138d7170c4ddc429e230a3bc1c1719f67e14324749df200a4b90",
  "backend": "nvidia",
  "min_cuda": 12.9,
  "port": 8000,
  "entrypoint": "vllm",
  "args": [
    "serve",
    "/models/${name}",
    "--served-model-name",
    "${name}",
    "--host",
    "0.0.0.0",
    "--port",
    "8000",
    "--max-model-len",
    "${ctx}",
    "--max-num-seqs",
    "${seqs}",
    "--gpu-memory-utilization",
    "${mem}",
    "--kv-cache-dtype",
    "${kv}",
    "--enable-auto-tool-choice",
    "--tool-call-parser",
    "${tools}",
    "--reasoning-parser",
    "${think}",
    "${extra}"
  ],
  "shm": "16g",
  "weights_at": "/models/${name}",
  "defaults": {
    "ctx": 32768,
    "seqs": 1,
    "mem": 0.9,
    "kv": "auto",
    "tools": "qwen3_coder",
    "think": "qwen3",
    "vision": false,
    "extra": ""
  }
}

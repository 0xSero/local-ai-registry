{
  "id": "sglang",
  "engine": "sglang",
  "about": "SGLang 0.5.20 (CUDA 13), the upstream runtime image; NVFP4, FP8, AWQ/GPTQ and BF16 weights, OpenAI chat API",
  "image": "lmsysorg/sglang:v0.5.20-cu130-runtime@sha256:00b02004501e402332827ffd5343a225a8960d99adc990b37d6f31085b8f6800",
  "backend": "nvidia",
  "min_cuda": 13.0,
  "port": 30000,
  "entrypoint": "python3",
  "args": [
    "-m",
    "sglang.launch_server",
    "--model-path",
    "/models/${name}",
    "--served-model-name",
    "${name}",
    "--host",
    "0.0.0.0",
    "--port",
    "30000",
    "--trust-remote-code",
    "--context-length",
    "${ctx}",
    "--max-running-requests",
    "${seqs}",
    "--mem-fraction-static",
    "${mem}",
    "--kv-cache-dtype",
    "${kv}",
    "--tool-call-parser",
    "${tools}",
    "--reasoning-parser",
    "${think}",
    "${extra}"
  ],
  "shm": "16g",
  "weights_at": "/models/${name}",
  "defaults": {
    "ctx": 32768,
    "seqs": 1,
    "mem": 0.85,
    "kv": "auto",
    "tools": "qwen3_coder",
    "think": "qwen3",
    "vision": false,
    "extra": ""
  }
}

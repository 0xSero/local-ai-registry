  ],
  "args": [
    "-m",
    "sglang.launch_server",
    "--model-path",
    "${CONTAINER_MODEL}",
    "--trust-remote-code",
    "--served-model-name",
    "inkling-small",
    "--tp-size",
    "2",
    "--context-length",
    "1048576",
    "--quantization",
    "modelopt_fp4",
    "--attention-backend",
    "triton",
    "--page-size",
    "1",
    "--fp4-gemm-backend",
    "flashinfer_trtllm",
    "--moe-runner-backend",
    "marlin",
    "--mamba-radix-cache-strategy",
    "extra_buffer",
    "--mem-fraction-static",
    "0.85",
    "--swa-full-tokens-ratio",
    "0.1",
    "--mamba-full-memory-ratio",
    "0.1",
    "--max-running-requests",
    "16",
    "--chunked-prefill-size",
    "8192",
    "--reasoning-parser",
    "inkling",
    "--tool-call-parser",
    "inkling",
    "--skip-server-warmup",
    "--disable-flashinfer-autotune",
    "--stream-interval",
    "32",
    "--speculative-algorithm",

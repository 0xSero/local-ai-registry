{
  "id": "sglang-inkling-small-nvfp4-1024k-2x",
  "engine": "sglang",
  "about": "Inkling-Small NVFP4 as miaai-lab runs it (MiaAI-Lab/Inkling-Small-NVFP4-Dual-DGX-Sparks)",

  "shm": "16g",
  "weights": [
    {
      "repo": "thinkingmachines/Inkling-Small-NVFP4",
      "revision": "b6a99534467840620d411e4cd4ad5819b2610d9c",
      "at": "/root/.cache/huggingface",
      "layout": "hub"
    }
  ],
  "config": null,
  "ctx": 1048576,
  "seqs": 1,
  "vision": false,
  "cards": 1,
  "flags": [
    "--network host",
    "--gpus all",
    "--shm-size 16g",
    "--ipc host",
    "--privileged",
    "--device /dev/infiniband",
    "--cap-add IPC_LOCK",
    "--ulimit memlock=-1",
    "--ulimit stack=67108864"
  ],
  "machines": 2,
  "setup": "Two Sparks linked over CX7 RoCEv2 (10.0.22.1/.2). Shared ed25519 key head->worker; worker mounts head HF cache via SSHFS at /mnt/head-hf-cache (user_allow_other in /etc/fuse.conf) and binds it to /root/.cache/huggingface. Image is pulled on head, tagged local/sglang-inkling:gb10-kvquant, docker save/load to worker. Download thinkingmachines/Inkling-Small-NVFP4 and RadixArk/Inkling-Small-DSpark-Preview into ~/.cache/huggingface on head.",
  "source": "https://github.com/MiaAI-Lab/Inkling-Small-NVFP4-Dual-DGX-Sparks/tree/ce6bfbe90d6e680e7b8172ebd1922fa148158e26"

    "fp4_mx_block16",
    "--cuda-graph-bs",
    "1",
    "2",
    "3",
    "4",
    "5",
    "6",
    "7",
    "8",
    "10",
    "12",
    "14",
    "16",
    "--nnodes",
    "2",
    "--node-rank",
    "${NODE_RANK}",
    "--dist-init-addr",
    "10.0.22.1:25000",
    "--host",
    "0.0.0.0",

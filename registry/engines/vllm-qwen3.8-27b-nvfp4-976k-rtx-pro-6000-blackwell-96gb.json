  "env": {
    "VLLM_TARGET_DEVICE": "cuda",
    "VLLM_FLOAT32_MATMUL_PRECISION": "high",
    "CUTE_DSL_ARCH": "sm_121a",
    "VLLM_ALLOW_LONG_MAX_MODEL_LEN": "1",
    "HF_HOME": "/root/.cache/huggingface",
    "TRITON_CACHE_DIR": "/root/.triton",
    "HF_TOKEN": "${HF_TOKEN:-}"
  },
  "shm": null,
  "weights": [
    {
      "repo": "unsloth/Qwen3.8-27B-NVFP4",
      "revision": "f0b7c9e722f5565102fff8481c99e4d86ae099c7",
      "at": "/root/.cache/huggingface",
      "layout": "hub"
    }
  ],
  "config": null,
  "ctx": 1000000,
  "seqs": 1,
  "vision": true,
  "cards": 1,
  "flags": [
    "--network host",
    "--ipc host",
    "--privileged",
    "--gpus all"
  ],
  "setup": "./download.sh pre-downloads into ./.cache/huggingface (HF_HUB_DISABLE_XET=1, 10 retries, HF_TOKEN read from ~/.bashrc); mounts ./.cache/huggingface -> /root/.cache/huggingface and ./.cache/triton -> /root/.triton.",

{
  "id": "sglang-exl3",
  "engine": "sglang",
  "about": "SGLang with the EXL3 kernels (0xSero/sglang-exl3, the image behind the 3090 and 4090 Qwen3.8-27B recipes); EXL3 weights, OpenAI chat API",
  "image": "ghcr.io/0xsero/sglang-exl3@sha256:84f75f3424c99a3d63392a4e0348292bdeba9cf7efba2ff1aa9b85c8fc0131e8",
  "backend": "nvidia",
  "min_cuda": 12.9,
  "port": 30000,
  "entrypoint": "/opt/entrypoint.sh",
  "args": [
    "python3",
    "-m",
    "sglang.launch_server",
    "--model-path",
    "/models/${name}",
    "--quantization",
    "exl3",
    "--trust-remote-code",
    "--host",
    "0.0.0.0",
    "--port",
    "30000",
    "--served-model-name",
    "${name}",
    "--context-length",
    "${ctx}",
    "--mem-fraction-static",
    "${mem}",
    "--kv-cache-dtype",
    "${kv}",
    "--max-running-requests",
    "${seqs}",
    "--chunked-prefill-size",
    "1024",
    "--max-prefill-tokens",
    "1024",
    "--reasoning-parser",
    "${think}",
    "--tool-call-parser",
    "${tools}",
    "${extra}"
  ],
  "env": {
    "CUDA_DEVICE_ORDER": "PCI_BUS_ID",
    "HF_HUB_OFFLINE": "1",
    "SGLANG_EXL3_EMBED_HOST": "1",
    "SGLANG_EXL3_KERNEL": "auto",
    "SGLANG_EXL3_MODEL_PATH": "/models/${name}"
  },
  "shm": "16g",
  "weights_at": "/models/${name}",
  "defaults": {
    "ctx": 32768,
    "seqs": 1,
    "mem": 0.8,
    "kv": "fp8_e4m3",
    "tools": "qwen3_coder",
    "think": "qwen3",
    "vision": false,
    "extra": ""
  }
}

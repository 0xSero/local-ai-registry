# Qwen3.8-Flash-Next on spark-de5c (head) + spark-557f (worker), vLLM TP2+EP+MTP3.
# Fabric: ConnectX RoCE <fabric-ip>/24. Served name and full context per operator request.
HEAD_IP="<fabric-ip>"
WORKER_IP="<fabric-ip>"
WORKER_USER="<user>"
IFACE="enp1s0f1np1"
IB_HCA="=rocep1s0f1"
IB_GID_INDEX=3

MODEL_ID="nvidia/Qwen3.8-Flash-Next-NVFP4"
ABLIT=0
SERVED_MODEL_NAME="qwen3.8-next-flash"

# Full context: 262,144 native x 4.0 YaRN = ~1,048,576.
MAX_MODEL_LEN=262144
YARN_ENABLE=false
YARN_FACTOR=4.0
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1

GPU_MEMORY_UTILIZATION=0.835
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
PORT=8888

KV_CACHE_DTYPE=fp8
MAMBA_SSM_CACHE_DTYPE=bfloat16
TENSOR_PARALLEL_SIZE=2
ENABLE_EXPERT_PARALLEL=true
MM_ENCODER_TP_MODE=data
MTP_NUM_SPECULATIVE_TOKENS=3

IMAGE="vllm/vllm-openai:qwen38-flash-next"
PLE_OFFLOAD=false
MTP_DRAFT_VOCAB="files/draft_vocab_own_65k.txt"
FP8_DENSE=false
QSA_PROFILE=stock
REQUIRE_IDLE_GPU=true
EVICT_PAGE_CACHE=true
MASTER_PORT=50000
NFS_SHARE=false
API_HOST=0.0.0.0
